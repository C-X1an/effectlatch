{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_digest",
    "grant_id",
    "input_b64"
  ],
  "properties": {
    "module_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grant_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_b64": {
      "type": "string",
      "contentEncoding": "base64"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fuel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "max_effects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    }
  }
}
